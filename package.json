{
  "name": "theveilpress",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "oxlint",
    "preview": "astro preview",
    "scan": "node scripts/scanIndex.js",
    "validate-articles": "node scripts/validateArticles.js",
    "ci": "npm run scan && npm run validate-articles && npm run check && npm run build",
    "postbuild": "npx pagefind --site dist/client && node -e \"require('fs').cpSync('dist/client/pagefind','.vercel/output/static/pagefind',{recursive:true})\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^5.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^9.0.5",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@vercel/analytics": "^2.0.1",
    "astro": "^5.18.2",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "marked": "^18.0.7",
    "pagefind": "^1.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "resend": "^6.18.1",
    "three": "^0.185.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
