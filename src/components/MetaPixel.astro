---
/**
 * Meta (Facebook) Pixel — base code + PageView.
 * No-op unless PUBLIC_META_PIXEL_ID is set in the environment (same gating
 * pattern as PUBLIC_BRIEF_FORM_ACTION). Safe to include unconditionally.
 */
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const hasPixel = typeof pixelId === 'string' && pixelId.trim().length > 0;
---

{
  hasPixel && (
    <script define:vars={{ pixelId }} is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', pixelId);
      window.fbq('track', 'PageView');
    </script>
  )
}
