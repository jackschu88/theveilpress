---
/**
 * Shared capture CTA — links to /brief tagged with a source for segmentation.
 * variant "strip": full-width banner (homepage, /watch foot).
 * variant "rail": compact card (desk article sidebar).
 */
interface Props {
  source: string;
  variant?: 'strip' | 'rail';
  heading?: string;
  text?: string;
}

const {
  source,
  variant = 'strip',
  heading = 'Get the first chapter free',
  text = 'Volume Zero and Part I — no card, no catch. We\'ll also send the occasional signal through the noise.',
} = Astro.props;

const href = `/brief?src=${encodeURIComponent(source)}`;
---

{
  variant === 'rail' ? (
    <div class="vp-glass vp-glass--rail rail-section brief-cta-rail">
      <h4 class="rail-heading">Free chapter</h4>
      <p class="rail-cta-text">{heading}</p>
      <a href={href} class="rail-cta-link">Read it now →</a>
    </div>
  ) : (
    <div class="vp-glass vp-glass--card brief-cta-strip">
      <div class="brief-cta-copy">
        <p class="vp-eyebrow">Not ready to buy?</p>
        <h2 class="brief-cta-heading">{heading}</h2>
        <p class="brief-cta-dek">{text}</p>
      </div>
      <a href={href} class="vp-btn vp-btn--primary vp-btn--gold">Get the free chapter</a>
    </div>
  )
}

<style>
  .brief-cta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--vp-space-5);
    padding: var(--vp-space-6);
  }

  .brief-cta-copy {
    flex: 1;
    min-width: 16rem;
  }

  .brief-cta-heading {
    font-family: 'Cinzel', serif;
    font-size: 1.35rem;
    color: var(--vp-text-primary);
    margin: var(--vp-space-1) 0;
    line-height: 1.3;
  }

  .brief-cta-dek {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--vp-text-secondary);
    margin: 0;
  }

  .brief-cta-rail {
    padding: var(--vp-space-4);
  }

  .brief-cta-rail .rail-heading {
    font-family: 'Cinzel', serif;
    font-size: 0.9rem;
    color: var(--vp-text-muted);
    margin: 0 0 var(--vp-space-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .brief-cta-rail .rail-cta-text {
    font-size: 0.95rem;
    color: var(--vp-text-primary);
    font-weight: 500;
    margin: 0 0 var(--vp-space-2);
  }

  .brief-cta-rail .rail-cta-link {
    color: var(--vp-accent-gold);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .brief-cta-rail .rail-cta-link:hover {
    color: var(--vp-accent-gold-hi);
  }
</style>
