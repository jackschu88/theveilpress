---
/**
 * The Record — horizontal archive strip.
 * Renders the media archive (films + podcast episodes) as a scrollable
 * broadcast-style strip. Used on Watch and the homepage.
 *
 * Must be mounted inside an element with the .vp-page shell so CSS vars resolve.
 */
import { archive } from '../data/archive.js';

interface Props {
  heading?: string;
  dek?: string;
  limit?: number;
  /** Link destination when an entry has no hosted media (e.g. upcoming podcast). */
  fallbackHref?: string;
}

const {
  heading = 'The Record',
  dek = 'Films and episodes — canonical files stay on site.',
  limit,
  fallbackHref = '/watch',
} = Astro.props;

const items = limit ? archive.slice(0, limit) : archive;
---

<section class="archive-strip-section">
  <div class="archive-strip-head">
    <div>
      <p class="vp-eyebrow">Media archive</p>
      <h2 class="archive-strip-title">{heading}</h2>
      <p class="archive-strip-dek">{dek}</p>
    </div>
    <a href="/watch" class="vp-btn vp-btn--ghost archive-strip-all">View all</a>
  </div>

  <div class="archive-strip-track" data-archive-strip>
    {items.map((entry) => {
      const href = entry.soon
        ? (entry.href || fallbackHref)
        : entry.href || '/watch';
      const label = entry.soon
        ? 'Coming soon'
        : entry.kind === 'film'
          ? entry.duration || 'Film'
          : 'Episode';
      return (
        <article
          class:list={[
            'archive-record',
            entry.soon && 'archive-record--soon',
            entry.kind === 'podcast' && 'archive-record--podcast',
          ]}
        >
          <div class="archive-record-num">REC · {entry.num}</div>

          {entry.src ? (
            <div class="archive-record-frame">
              <video
                playsinline
                preload="metadata"
                muted
                loop
                poster={entry.poster}
                aria-label={entry.title}
              >
                <source src={entry.src} type="video/mp4" />
              </video>
              <span class="archive-record-tag">{label}</span>
            </div>
          ) : (
            <a href={href} class="archive-record-poster archive-record-poster--empty">
              <span class="archive-record-tag">{label}</span>
              <span class="archive-record-poster-label">{entry.dek || 'Episodes'}</span>
            </a>
          )}

          <div class="archive-record-body">
            <h3 class="archive-record-name">
              {entry.src ? entry.title : <a href={href}>{entry.title}</a>}
            </h3>
            {entry.dek && <p class="archive-record-dek">{entry.dek}</p>}
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .archive-strip-section {
    /* relies on parent .vp-page / .home-section padding */
  }

  .archive-strip-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--vp-space-4);
    margin-bottom: var(--vp-space-5);
  }

  .archive-strip-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    color: var(--vp-text-primary);
    margin: var(--vp-space-1) 0;
    letter-spacing: 0.04em;
  }

  .archive-strip-dek {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--vp-text-secondary);
    margin: 0;
    max-width: 34rem;
  }

  .archive-strip-all {
    flex-shrink: 0;
  }

  .archive-strip-track {
    display: flex;
    gap: var(--vp-space-4);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: var(--vp-space-1) var(--vp-space-1) var(--vp-space-4);
    scrollbar-width: thin;
  }

  .archive-record {
    flex: 0 0 auto;
    width: 240px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-3);
  }

  .archive-record-num {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--vp-accent-gold);
    text-transform: uppercase;
  }

  .archive-record-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--vp-radius-sm);
    overflow: hidden;
    border: 1px solid var(--vp-edge);
    background: #000;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .archive-record-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .archive-record-frame:hover video {
    opacity: 0.92;
  }

  .archive-record-tag {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    z-index: 2;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0c0e14;
    background: var(--vp-accent-gold);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
  }

  .archive-record-poster {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--vp-radius-sm);
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: var(--vp-space-3);
    text-decoration: none;
    background:
      linear-gradient(180deg, rgba(196, 165, 116, 0.06), rgba(7, 8, 12, 0.55)),
      var(--vp-bg-fog);
    border: 1px dashed var(--vp-edge-hot);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .archive-record-poster--empty:hover {
    border-color: var(--vp-accent-gold);
  }

  .archive-record-poster-label {
    font-family: 'Cinzel', serif;
    font-size: 0.95rem;
    color: var(--vp-text-secondary);
    max-width: 12rem;
  }

  .archive-record-body {
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-1);
  }

  .archive-record-name {
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--vp-text-primary);
    margin: 0;
  }

  .archive-record-name a {
    color: inherit;
    text-decoration: none;
  }

  .archive-record-name a:hover {
    color: var(--vp-accent-gold);
  }

  .archive-record-dek {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--vp-text-muted);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-record-frame:hover video {
      opacity: 1;
    }
  }
</style>
