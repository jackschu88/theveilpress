---
/**
 * Sitewide capture nudge — shows once per session on 50% scroll depth
 * (mobile) or exit-intent (desktop mouseleave at top of viewport).
 * Skipped entirely on /brief* and /read, which already show the offer.
 */
---

<div id="capture-nudge" class="capture-nudge" hidden>
  <div class="capture-nudge-inner vp-glass vp-glass--card">
    <button type="button" class="capture-nudge-close" aria-label="Dismiss">×</button>
    <p class="capture-nudge-heading">Get the first chapter free</p>
    <p class="capture-nudge-text">No card, no catch — Volume Zero and Part I, sent straight over.</p>
    <a href="/brief?src=nudge" class="vp-btn vp-btn--primary vp-btn--gold capture-nudge-cta">
      Get the free chapter
    </a>
  </div>
</div>

<script>
  const KEY = 'veilpress-nudge-seen';
  const SKIP_PREFIXES = ['/brief', '/read'];

  function init() {
    if (SKIP_PREFIXES.some((p) => window.location.pathname.startsWith(p))) return;
    try {
      if (sessionStorage.getItem(KEY)) return;
    } catch {
      /* ignore */
    }

    const el = document.getElementById('capture-nudge');
    if (!el) return;

    let shown = false;
    const reveal = () => {
      if (shown) return;
      shown = true;
      el.hidden = false;
      requestAnimationFrame(() => el.classList.add('capture-nudge--visible'));
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {
        /* ignore */
      }
    };

    const dismiss = () => {
      el.classList.remove('capture-nudge--visible');
      window.setTimeout(() => {
        el.hidden = true;
      }, 300);
    };

    el.querySelector('.capture-nudge-close')?.addEventListener('click', dismiss);

    // Mobile / any device: 50% scroll depth.
    const onScroll = () => {
      const doc = document.documentElement;
      const scrolled = doc.scrollTop / (doc.scrollHeight - doc.clientHeight || 1);
      if (scrolled >= 0.5) {
        reveal();
        window.removeEventListener('scroll', onScroll);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // Desktop: exit intent (mouse leaves toward the top of the viewport).
    const onMouseLeave = (e: MouseEvent) => {
      if (e.clientY <= 0) {
        reveal();
        document.removeEventListener('mouseleave', onMouseLeave);
      }
    };
    document.addEventListener('mouseleave', onMouseLeave);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .capture-nudge {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 500;
    display: flex;
    justify-content: center;
    padding: var(--vp-space-4);
    pointer-events: none;
  }

  .capture-nudge-inner {
    pointer-events: auto;
    position: relative;
    max-width: 28rem;
    width: 100%;
    padding: var(--vp-space-5);
    text-align: center;
    transform: translateY(120%);
    opacity: 0;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .capture-nudge--visible .capture-nudge-inner {
    transform: translateY(0);
    opacity: 1;
  }

  .capture-nudge-close {
    position: absolute;
    top: var(--vp-space-2);
    right: var(--vp-space-3);
    background: none;
    border: none;
    color: var(--vp-text-muted);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: var(--vp-space-1);
  }

  .capture-nudge-close:hover {
    color: var(--vp-text-primary);
  }

  .capture-nudge-heading {
    font-family: 'Cinzel', serif;
    font-size: 1.05rem;
    color: var(--vp-text-primary);
    margin: 0 0 var(--vp-space-2);
  }

  .capture-nudge-text {
    font-size: 0.88rem;
    color: var(--vp-text-secondary);
    margin: 0 0 var(--vp-space-4);
  }

  .capture-nudge-cta {
    display: inline-block;
  }

  @media (prefers-reduced-motion: reduce) {
    .capture-nudge-inner {
      transition: none;
    }
  }
</style>
