---
/**
 * Single-purpose capture landing page for paid ad traffic.
 * One job: email for free chapter. Softcover is sold on thank-you / chapter end.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const formAction = import.meta.env.PUBLIC_BRIEF_FORM_ACTION;
const hasFormAction = typeof formAction === 'string' && formAction.trim().length > 0;
---

<BaseLayout
  title="Get the First Chapter Free"
  description="The Veil of the Square Mile — the City of London’s parallel power, documented. Read the first chapter free. No card."
  minimal
>
  <section class="read-page">
    <div class="read-stage" aria-hidden="true"></div>

    <div class="read-panel">
      <p class="vp-eyebrow">Free chapter · No card required</p>
      <h1 class="read-title">The City of London predates the United Kingdom — and still runs on its own rules.</h1>

      <p class="read-what">
        <em>The Veil of the Square Mile</em> is a 384-page analytical history of how the City of
        London Corporation — a medieval corporation that still sits at the center of global finance —
        built and kept power outside the normal state. Sources on the record. Not slogans.
      </p>
      <p class="read-dek">
        Get Volume Zero and Part I free by email. Instant access on the next page.
      </p>

      <div class="vp-glass vp-glass--card read-form-card">
        {
          hasFormAction ? (
            <form class="read-form" method="post" action="/api/brief-signup">
              <label class="read-label" for="read-email">Email for the free chapter</label>
              <div class="read-form-row">
                <input
                  id="read-email"
                  class="read-input"
                  type="email"
                  name="email"
                  placeholder="you@email.com"
                  required
                  autocomplete="email"
                />
                <button class="read-submit" type="submit">Send me the free chapter</button>
              </div>
              <input type="hidden" name="source" value="read-landing" />
              <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
            </form>
          ) : (
            <p class="vp-text-muted">Signup is temporarily unavailable — check back soon.</p>
          )
        }
        <p class="read-disclaimer vp-text-muted">No spam. Unsubscribe anytime.</p>
      </div>

      <ul class="read-bullets">
        <li>Primary sources and institutional record — not conspiracy theater</li>
        <li>Fifteen parts mapping finance, empire, and parallel sovereignty</li>
        <li>Written by a combat veteran (82nd Airborne) with degrees in History and English</li>
      </ul>

      <div class="read-trailer-frame">
        <video
          class="read-trailer-video"
          controls
          playsinline
          preload="metadata"
          poster="/cover.jpg"
          aria-label="The Veil of the Square Mile — official trailer"
        >
          <source src="/videos/square-mile-trailer.mp4" type="video/mp4" />
        </video>
      </div>

      <p class="read-alt">
        Prefer print now?
        <a href="https://shop.theveilpress.com/l/jiytnb" rel="noopener noreferrer" target="_blank"
          >Softcover — $39.99 + shipping →</a
        >
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .read-page {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--vp-space-7) var(--vp-space-5);
  }

  .read-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 40%, rgba(16, 19, 28, 0.2), transparent 70%),
      url('/limited-founders-hero-wide.jpg') center / cover no-repeat;
    opacity: 0.3;
    pointer-events: none;
  }

  .read-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(7, 8, 12, 0.6) 0%,
      rgba(7, 8, 12, 0.8) 60%,
      var(--vp-bg-deep) 100%
    );
  }

  .read-panel {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    width: 100%;
    text-align: center;
  }

  .read-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.45rem, 4.2vw, 2.1rem);
    font-weight: 600;
    color: var(--vp-text-primary);
    margin: var(--vp-space-3) 0 var(--vp-space-4);
    line-height: 1.25;
  }

  .read-what {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--vp-text-secondary);
    margin: 0 0 var(--vp-space-3);
    text-align: left;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  .read-dek {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--vp-text-muted);
    margin: 0 0 var(--vp-space-5);
  }

  .read-form-card {
    padding: var(--vp-space-6);
    margin-bottom: var(--vp-space-5);
  }

  .read-label {
    display: block;
    text-align: left;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--vp-text-muted);
    margin: 0 0 var(--vp-space-2);
  }

  .read-form-row {
    display: flex;
    gap: var(--vp-space-2);
    max-width: 28rem;
    margin: 0 auto;
  }

  .read-input {
    flex: 1;
    padding: var(--vp-space-3) var(--vp-space-4);
    border: 1px solid var(--vp-edge);
    border-radius: var(--vp-radius-sm);
    background: var(--vp-bg-deep);
    color: var(--vp-text-primary);
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
  }

  .read-input:focus {
    outline: none;
    border-color: var(--vp-edge-hot);
  }

  .read-submit {
    padding: var(--vp-space-3) var(--vp-space-5);
    border: none;
    border-radius: var(--vp-radius-sm);
    background: var(--vp-accent-gold);
    color: #0c0e14;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--vp-duration) var(--vp-ease);
  }

  .read-submit:hover {
    background: var(--vp-accent-gold-hi);
  }

  .read-disclaimer {
    font-size: 0.8rem;
    margin: var(--vp-space-3) 0 0;
  }

  .read-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--vp-space-6);
    text-align: left;
    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
  }

  .read-bullets li {
    position: relative;
    padding-left: 1.15rem;
    margin: 0 0 var(--vp-space-2);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--vp-text-secondary);
  }

  .read-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--vp-accent-gold);
    opacity: 0.85;
  }

  .read-trailer-frame {
    border-radius: var(--vp-radius-md, 6px);
    overflow: hidden;
    border: 1px solid var(--vp-edge);
    background: #000;
    margin: 0 auto var(--vp-space-5);
    box-shadow: 0 0 40px rgba(196, 165, 116, 0.08), 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .read-trailer-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .read-alt {
    margin: 0;
    font-size: 0.85rem;
    color: var(--vp-text-muted);
  }

  .read-alt a {
    color: var(--vp-accent-gold);
    text-decoration: none;
  }

  .read-alt a:hover {
    color: var(--vp-accent-gold-hi);
    text-decoration: underline;
  }

  @media (max-width: 520px) {
    .read-form-row {
      flex-direction: column;
    }
  }
</style>
