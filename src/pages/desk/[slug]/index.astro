---
/**
 * Article detail — file-based load from content/articles (Bezalel packages).
 */
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import DeskLayout from '../../../layouts/DeskLayout.astro';
import AdSlot from '../../../components/ads/AdSlot.astro';
import { loadArticleBySlug, uniqueArticleSlugs } from '../../../lib/loadArticles';

const SITE_ROOT = process.cwd();
const siteIndex: any = JSON.parse(
  fs.readFileSync(path.join(SITE_ROOT, 'data', 'site-index.json'), 'utf-8'),
);

export function getStaticPaths() {
  return uniqueArticleSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const article = loadArticleBySlug(slug!);

if (!article) {
  return new Response(`Article not found: ${slug}`, {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

const html = await marked.parse(article.body);
const data = article.data;
const seoDesc = data.dek || data.description || '';
const tags: string[] = Array.isArray(data.tags) ? data.tags : [];
const entityIds: string[] = Array.isArray(data.entityIds) ? data.entityIds : [];
const claimIds: string[] = Array.isArray(data.claimIds) ? data.claimIds : [];
const citations: string[] = Array.isArray(data.citations) ? data.citations : [];

const entityMap = new Map<string, any>((siteIndex.entities || []).map((e: any) => [e.id, e]));
const claimMap = new Map<string, any>((siteIndex.claims || []).map((c: any) => [c.id, c]));

const dateObj = data.date ? new Date(data.date) : null;
const dateLabel =
  dateObj && !Number.isNaN(dateObj.getTime())
    ? dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
    : '';
const dateIso = dateObj && !Number.isNaN(dateObj.getTime()) ? dateObj.toISOString() : '';
const pageTitle = data.seo_title || data.title || slug;
const pageImage = typeof data.image === 'string' ? data.image : undefined;
---

<DeskLayout title={pageTitle} description={seoDesc} image={pageImage}>
  <article class="article-page">
    <nav class="article-breadcrumb">
      <a href="/desk">Desk</a>
      <span class="breadcrumb-sep">/</span>
      <span>{data.title}</span>
    </nav>

    <div class="article-layout">
      <div class="article-body">
        <header class="article-header">
          <h1>{data.title}</h1>
          {seoDesc && <p class="article-dek">{seoDesc}</p>}
          <div class="article-meta">
            {dateIso && <time datetime={dateIso}>{dateLabel}</time>}
            {tags.length > 0 && (
              <span class="article-tags">
                {tags.map((t) => (
                  <span class="vp-tag">{t}</span>
                ))}
              </span>
            )}
          </div>
        </header>

        <div class="article-content" set:html={html} />

        {citations.length > 0 && (
          <section class="article-citations">
            <h3>Sources</h3>
            <ol>
              {citations.map((url) => (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer">{url}</a>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

      <aside class="article-rail">
        {entityIds.length > 0 && (
          <div class="vp-glass vp-glass--rail rail-section">
            <h4 class="rail-heading">Entities</h4>
            <ul class="rail-list">
              {entityIds.map((eid) => {
                const entity = entityMap.get(eid);
                return (
                  <li>
                    <a href={`/desk/entities/${eid}`}>{entity ? entity.canonicalName : eid}</a>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        {claimIds.length > 0 && (
          <div class="vp-glass vp-glass--rail rail-section">
            <h4 class="rail-heading">Claims</h4>
            <ul class="rail-list">
              {claimIds.map((cid) => {
                const claim = claimMap.get(cid);
                return claim ? (
                  <li class="rail-claim-item">
                    <span class="rail-claim-label">{claim.evidentiaryWeight}</span>
                    <p class="rail-claim-statement">{claim.statement}</p>
                  </li>
                ) : null;
              })}
            </ul>
          </div>
        )}

        <AdSlot slot="article-rail" />

        <div class="vp-glass vp-glass--rail rail-section">
          <h4 class="rail-heading">The Brief</h4>
          <p class="rail-cta-text">Weekly signal through the noise.</p>
          <a href="/brief" class="rail-cta-link">Subscribe →</a>
        </div>
      </aside>
    </div>
  </article>
</DeskLayout>

<style>
  .article-page { max-width: 72rem; }
  .article-breadcrumb { font-size: 0.85rem; color: var(--vp-text-muted); margin-bottom: var(--vp-space-6); }
  .article-breadcrumb a { color: var(--vp-accent-steel); text-decoration: none; }
  .article-breadcrumb a:hover { color: var(--vp-accent-gold); }
  .breadcrumb-sep { margin: 0 var(--vp-space-2); }
  .article-layout { display: grid; grid-template-columns: 1fr 280px; gap: var(--vp-space-6); align-items: start; }
  @media (max-width: 860px) { .article-layout { grid-template-columns: 1fr; } }
  .article-body {
    background: var(--vp-bg-elevated);
    border-radius: var(--vp-radius-md);
    padding: var(--vp-space-6);
    min-width: 0;
    border: 1px solid var(--vp-edge);
  }
  .article-header { margin-bottom: var(--vp-space-6); border-bottom: 1px solid var(--vp-rule); padding-bottom: var(--vp-space-5); }
  .article-header h1 {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    color: var(--vp-text-primary);
    margin: 0 0 var(--vp-space-3);
    line-height: 1.25;
  }
  .article-dek {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.25rem;
    color: var(--vp-text-secondary);
    margin: 0 0 var(--vp-space-4);
    line-height: 1.55;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--vp-space-3);
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--vp-text-muted);
  }
  .article-content {
    color: var(--vp-text-primary);
    line-height: 1.75;
    font-size: 1.08rem;
    font-family: 'Source Sans 3', system-ui, sans-serif;
    max-width: 42rem;
  }
  .article-content :global(h2) {
    font-family: 'Cinzel', serif;
    font-size: 1.35rem;
    margin: var(--vp-space-7) 0 var(--vp-space-3);
    color: var(--vp-text-primary);
  }
  .article-content :global(h3) {
    font-family: 'Cinzel', serif;
    font-size: 1.12rem;
    margin: var(--vp-space-5) 0 var(--vp-space-2);
  }
  .article-content :global(p) { margin: 0 0 var(--vp-space-4); }
  .article-content :global(a) { color: var(--vp-accent-steel); text-underline-offset: 2px; }
  .article-content :global(a:hover) { color: var(--vp-accent-gold); }
  .article-content :global(strong) { color: var(--vp-text-primary); font-weight: 600; }
  .article-content :global(blockquote) {
    border-left: 2px solid var(--vp-accent-gold);
    padding: var(--vp-space-2) 0 var(--vp-space-2) var(--vp-space-4);
    margin: var(--vp-space-5) 0;
    color: var(--vp-text-secondary);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.2rem;
  }
  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 var(--vp-space-4);
    padding-left: var(--vp-space-5);
  }
  .article-content :global(li) { margin-bottom: var(--vp-space-2); }
  .article-citations { margin-top: var(--vp-space-6); padding-top: var(--vp-space-5); border-top: 1px solid var(--vp-rule); }
  .article-citations h3 { font-family: 'Cinzel', serif; font-size: 1rem; color: var(--vp-text-muted); margin: 0 0 var(--vp-space-3); }
  .article-citations ol { font-size: 0.8rem; color: var(--vp-text-muted); padding-left: var(--vp-space-5); }
  .article-citations a { color: var(--vp-accent-steel); word-break: break-all; }
  .article-rail { display: flex; flex-direction: column; gap: var(--vp-space-4); position: relative; z-index: 1; }
  .rail-section { padding: var(--vp-space-4); }
  .rail-heading { font-family: 'Cinzel', serif; font-size: 0.9rem; color: var(--vp-text-muted); margin: 0 0 var(--vp-space-3); text-transform: uppercase; letter-spacing: 0.05em; }
  .rail-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--vp-space-2); }
  .rail-list a { color: var(--vp-accent-steel); text-decoration: none; font-size: 0.9rem; }
  .rail-list a:hover { color: var(--vp-accent-gold); }
  .rail-claim-item { font-size: 0.85rem; }
  .rail-claim-label { display: inline-block; padding: 1px 6px; background: var(--vp-glass-fill-strong); border: 1px solid var(--vp-edge); border-radius: var(--vp-radius-sm); font-size: 0.7rem; text-transform: uppercase; color: var(--vp-text-muted); margin-bottom: var(--vp-space-1); }
  .rail-claim-statement { color: var(--vp-text-secondary); margin: 0; line-height: 1.4; }
  .rail-cta-text { font-size: 0.85rem; color: var(--vp-text-secondary); margin: 0 0 var(--vp-space-2); }
  .rail-cta-link { color: var(--vp-accent-gold); text-decoration: none; font-size: 0.9rem; font-weight: 500; }
  .rail-cta-link:hover { color: var(--vp-accent-gold-hi); }
</style>
