---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import DeskLayout from '../../layouts/DeskLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';

const ARTICLES_DIR = path.join(process.cwd(), 'content', 'articles');
let articles: any[] = [];
if (fs.existsSync(ARTICLES_DIR)) {
  for (const file of fs.readdirSync(ARTICLES_DIR)) {
    if (!file.endsWith('.md')) continue;
    const raw = fs.readFileSync(path.join(ARTICLES_DIR, file), 'utf-8');
    const fm = matter(raw);
    if (fm.data) articles.push(fm);
  }
}
const published = articles
  .filter((a) => a.data.status !== 'draft' && a.data.slug)
  .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Numbered-archive sequencing: newest = lowest number.
const numbered = published.map((a, i) => ({ ...a, recordNum: String(i + 1).padStart(2, '0') }));

const lead = numbered[0] ?? null;
const rest = numbered.slice(1);
---

<DeskLayout
  title="The Desk"
  description="News and analysis from The Veil Press desk — durable power, documented with sources."
>
  <header class="desk-header">
    <p class="vp-eyebrow">The Desk · Published record</p>
    <h1 class="vp-page-title">Desk</h1>
    <p class="vp-page-dek">
      News and analysis on durable power — architecture, money, narrative, access.
      Sourced pieces from the control plane; not a wire service.
    </p>
  </header>

  {published.length === 0 ? (
    <div class="vp-glass vp-glass--card desk-empty">
      <p class="vp-text-secondary">The desk opens when the pipeline lands.</p>
    </div>
  ) : (
    <div class="desk-stack">
      {lead && (
        <a href={`/desk/${lead.data.slug}`} class="desk-lead vp-glass vp-glass--card" data-nav="article">
          <div class="desk-lead-img">
            <span class="desk-lead-num">REC · {lead.recordNum}</span>
            {lead.data.image ? (
              <img src={lead.data.image} alt="" loading="eager" />
            ) : (
              <span class="desk-cover-fallback desk-cover-fallback--lead" aria-hidden="true" />
            )}
          </div>
          <div class="desk-lead-body">
            <p class="vp-eyebrow">Latest</p>
            <h2 class="desk-lead-title">{lead.data.title}</h2>
            {(lead.data.dek || lead.data.description) && (
              <p class="desk-lead-dek">{lead.data.dek || lead.data.description}</p>
            )}
            <div class="desk-meta">
              <time datetime={String(lead.data.date)}>
                {new Date(lead.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              {lead.data.tags?.length > 0 && (
                <span class="desk-tags">
                  {lead.data.tags.slice(0, 4).map((t: string) => (
                    <span class="vp-tag">{t}</span>
                  ))}
                </span>
              )}
            </div>
          </div>
        </a>
      )}

      <AdSlot slot="desk-inline" />

      {rest.length > 0 && (
        <div class="desk-list">
          {rest.map((article) => (
            <a href={`/desk/${article.data.slug}`} class="desk-row vp-glass vp-glass--card" data-nav="article">
              <div class="desk-row-img">
                <span class="desk-row-num">REC · {article.recordNum}</span>
                {article.data.image ? (
                  <img src={article.data.image} alt="" loading="lazy" />
                ) : (
                  <span class="desk-cover-fallback" aria-hidden="true" />
                )}
              </div>
              <div class="desk-row-body">
                <h2 class="desk-row-title">{article.data.title}</h2>
                {(article.data.dek || article.data.description) && (
                  <p class="desk-row-dek">{article.data.dek || article.data.description}</p>
                )}
                <div class="desk-meta">
                  <time datetime={String(article.data.date)}>
                    {new Date(article.data.date).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  {article.data.tags?.length > 0 && (
                    <span class="desk-tags">
                      {article.data.tags.slice(0, 3).map((t: string) => (
                        <span class="vp-tag">{t}</span>
                      ))}
                    </span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  )}
</DeskLayout>

<style>
  .desk-header {
    margin-bottom: var(--vp-space-6);
  }

  .desk-empty {
    padding: var(--vp-space-6);
    text-align: center;
  }

  .desk-stack {
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-5);
  }

  .desk-lead,
  .desk-row {
    position: relative;
    z-index: 1;
    cursor: pointer;
  }

  .desk-lead {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    overflow: hidden;
    padding: 0;
  }

  .desk-lead-img {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 2;
    background: var(--vp-bg-fog);
  }

  .desk-lead-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .desk-lead-num,
  .desk-row-num {
    position: absolute;
    z-index: 2;
    top: 0.6rem;
    left: 0.6rem;
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #0c0e14;
    background: var(--vp-accent-gold);
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  .desk-cover-fallback {
    position: absolute;
    inset: 0;
    display: block;
    background:
      radial-gradient(120% 120% at 85% 10%, rgba(196, 165, 116, 0.18), transparent 55%),
      linear-gradient(160deg, var(--vp-bg-fog), #0a0c12);
  }

  .desk-cover-fallback::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(196, 165, 116, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(196, 165, 116, 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .desk-cover-fallback--lead {
    /* slightly stronger treatment for the lead */
  }

  .desk-lead-body {
    padding: var(--vp-space-7);
  }

  .desk-lead-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    color: var(--vp-text-primary);
    margin: 0 0 var(--vp-space-3);
    line-height: 1.25;
  }

  .desk-lead-dek {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--vp-text-secondary);
    margin: 0 0 var(--vp-space-4);
    max-width: 46rem;
  }

  .desk-list {
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-5);
  }

  .desk-row {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-decoration: none;
    padding: 0;
    overflow: hidden;
  }

  .desk-row-img {
    position: relative;
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    background: var(--vp-bg-fog);
  }

  .desk-row-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .desk-row-body {
    padding: var(--vp-space-6);
  }

  .desk-row-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    color: var(--vp-text-primary);
    margin: 0 0 var(--vp-space-2);
    line-height: 1.3;
  }

  .desk-row:hover .desk-row-title,
  .desk-lead:hover .desk-lead-title {
    color: var(--vp-accent-gold);
  }

  .desk-row-dek {
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--vp-text-secondary);
    margin: 0 0 var(--vp-space-3);
    max-width: 46rem;
  }

  .desk-meta {
    display: flex;
    align-items: center;
    gap: var(--vp-space-3);
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--vp-text-muted);
  }

  .desk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vp-space-1);
  }

  @media (max-width: 700px) {
    .desk-lead {
      flex-direction: column;
    }
    .desk-lead-img {
      aspect-ratio: 5 / 2;
    }
    .desk-row-img {
      aspect-ratio: 5 / 2;
    }
  }
</style>
