---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import DeskLayout from '../../layouts/DeskLayout.astro';

const ARTICLES_DIR = path.join(process.cwd(), 'content', 'articles');
let articles: any[] = [];
if (fs.existsSync(ARTICLES_DIR)) {
  for (const file of fs.readdirSync(ARTICLES_DIR)) {
    if (!file.endsWith('.md')) continue;
    const raw = fs.readFileSync(path.join(ARTICLES_DIR, file), 'utf-8');
    const fm = matter(raw);
    if (fm.data) articles.push(fm);
  }
}
const published = articles
  .filter(a => a.data.status !== 'draft')
  .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<DeskLayout>
  <h1>Desk</h1>
  {published.length === 0 ? (
    <div class="vp-glass vp-glass--card" style="padding:var(--vp-space-6);text-align:center">
      <p class="vp-text-secondary" style="margin:0">News &amp; analysis. The desk opens when the pipeline lands.</p>
    </div>
  ) : (
    <div class="desk-grid">
      {published.map(article => (
        <a href={`/desk/${article.data.slug}`} class="desk-card vp-glass vp-glass--card">
          {article.data.image && (
            <div class="desk-card-img">
              <img src={article.data.image} alt="" loading="lazy" />
            </div>
          )}
          <div class="desk-card-body">
            <h2 class="desk-card-title">{article.data.title}</h2>
            {(article.data.dek || article.data.description) && (
              <p class="desk-card-dek vp-text-secondary">{article.data.dek || article.data.description}</p>
            )}
            <div class="desk-card-meta">
              <time datetime={String(article.data.date)}>
                {new Date(article.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              {article.data.tags.length > 0 && (
                <span class="desk-card-tags">
                  {article.data.tags.slice(0, 3).map(t => (<span class="vp-tag">{t}</span>))}
                </span>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  )}
</DeskLayout>

<style>
  h1 { font-family: 'Cinzel', serif; color: var(--vp-text-primary); font-size: 1.75rem; margin: 0 0 var(--vp-space-6); }
  .desk-grid { display: flex; flex-direction: column; gap: var(--vp-space-5); }
  .desk-card { display: flex; gap: var(--vp-space-5); text-decoration: none; padding: var(--vp-space-5); }
  .desk-card:hover { border-color: var(--vp-edge-hot); }
  .desk-card-img { flex-shrink: 0; width: 160px; height: 100px; border-radius: var(--vp-radius-sm); overflow: hidden; }
  .desk-card-img img { width: 100%; height: 100%; object-fit: cover; }
  .desk-card-body { flex: 1; min-width: 0; }
  .desk-card-title { font-family: 'Cinzel', serif; font-size: 1.15rem; color: var(--vp-text-primary); margin: 0 0 var(--vp-space-2); }
  .desk-card-dek { font-size: 0.95rem; margin: 0 0 var(--vp-space-3); line-height: 1.5; }
  .desk-card-meta { display: flex; align-items: center; gap: var(--vp-space-3); flex-wrap: wrap; font-size: 0.8rem; color: var(--vp-text-muted); }
  .vp-tag { display: inline-block; padding: 2px 8px; border: 1px solid var(--vp-rule); border-radius: var(--vp-radius-sm); font-size: 0.75rem; color: var(--vp-text-muted); }
  @media (max-width: 600px) { .desk-card { flex-direction: column; } .desk-card-img { width: 100%; height: 140px; } }
</style>
