---
import BaseLayout from '../layouts/BaseLayout.astro';

const AMAZON_TAG = 'theveilpress-20';
function amazonSearch(query: string) {
  return `https://www.amazon.com/s?k=${encodeURIComponent(query)}&tag=${AMAZON_TAG}`;
}

const affiliates = [
  {
    id: 'ree-medical',
    name: 'REE Medical',
    tag: 'Veterans / VA claims',
    description:
      "Independent medical opinions and nexus letters for veterans building or appealing a VA disability claim. This is the service I personally used to move my own rating from 90% to 100%.",
    href: 'https://referrals.reemedical.com/l/JACKSCHUMA10/',
    cta: 'Get your free consultation',
  },
  {
    id: 'vettix',
    name: 'VetTix',
    tag: 'Veterans / free tickets',
    description:
      'A nonprofit that gives veterans, active-duty service members, and their families free tickets to sports, concerts, and other events. Sign up with my link and we both get bonus coins toward tickets.',
    href: 'https://www.vettix.org/ref/2106498',
    cta: 'Sign up for free tickets',
  },
];

const furtherReading = [
  {
    id: 'treasure-islands',
    name: 'Treasure Islands',
    author: 'Nicholas Shaxson',
    description:
      "Tax havens, offshore finance, and how the City of London sits at the center of that system — the closest thing to a direct extension of this book's subject.",
    href: amazonSearch('Treasure Islands Nicholas Shaxson'),
  },
  {
    id: 'moneyland',
    name: 'Moneyland',
    author: 'Oliver Bullough',
    description:
      'How the ultra-wealthy move money through secrecy jurisdictions and financial opacity — the same hidden architecture, traced globally.',
    href: amazonSearch('Moneyland Oliver Bullough'),
  },
  {
    id: 'kleptopia',
    name: 'Kleptopia',
    author: 'Tom Burgis',
    description:
      'Investigative journalism on dirty money, kleptocracy, and how Western financial systems enable it.',
    href: amazonSearch('Kleptopia Tom Burgis'),
  },
  {
    id: 'tower-of-basel',
    name: 'Tower of Basel',
    author: 'Adam LeBor',
    description:
      'The Bank for International Settlements and the hidden power of central banking — a different institution, the same architecture of power.',
    href: amazonSearch('Tower of Basel Adam LeBor'),
  },
];

const framingReading = [
  {
    id: 'unseen-realm',
    name: 'The Unseen Realm',
    author: 'Michael S. Heiser',
    description:
      "For readers interested in the deeper framing beneath this book's conclusion — the biblical divine council worldview, not financial history.",
    href: amazonSearch('The Unseen Realm Michael Heiser'),
  },
];
---

<BaseLayout
  title="Affiliates"
  description="Products and services I actually use and vouch for."
  noindex={true}
>
  <div class="vp-page affiliates-page">
    <header class="affiliates-header">
      <p class="vp-eyebrow">Recommended</p>
      <h1 class="vp-page-title">Affiliates</h1>
      <p class="vp-page-dek">
        A short list of products and services I've actually used and am glad to put my name
        behind. Some of these links pay me a referral if you sign up — that never changes
        whether something ends up on this page.
      </p>
    </header>

    <div class="affiliates-grid">
      {affiliates.map((a) => (
        <article class="affiliate-card vp-glass vp-glass--card" id={a.id}>
          <p class="vp-tag">{a.tag}</p>
          <h2 class="affiliate-name">{a.name}</h2>
          <p class="affiliate-desc">{a.description}</p>
          <a
            class="vp-btn vp-btn--primary"
            href={a.href}
            target="_blank"
            rel="noopener noreferrer sponsored"
          >
            {a.cta}
          </a>
        </article>
      ))}
    </div>

    <header class="affiliates-header affiliates-section">
      <p class="vp-eyebrow">Further Reading</p>
      <h2 class="vp-section-label">If this book was for you, so are these</h2>
    </header>

    <div class="affiliates-grid">
      {furtherReading.map((b) => (
        <article class="affiliate-card vp-glass vp-glass--card" id={b.id}>
          <p class="vp-tag">{b.author}</p>
          <h2 class="affiliate-name">{b.name}</h2>
          <p class="affiliate-desc">{b.description}</p>
          <a
            class="vp-btn vp-btn--secondary"
            href={b.href}
            target="_blank"
            rel="noopener noreferrer sponsored"
          >
            Find it on Amazon
          </a>
        </article>
      ))}
    </div>

    <header class="affiliates-header affiliates-section">
      <p class="vp-eyebrow">On the Deeper Framing</p>
      <h2 class="vp-section-label">Beneath the argument</h2>
    </header>

    <div class="affiliates-grid">
      {framingReading.map((b) => (
        <article class="affiliate-card vp-glass vp-glass--card" id={b.id}>
          <p class="vp-tag">{b.author}</p>
          <h2 class="affiliate-name">{b.name}</h2>
          <p class="affiliate-desc">{b.description}</p>
          <a
            class="vp-btn vp-btn--secondary"
            href={b.href}
            target="_blank"
            rel="noopener noreferrer sponsored"
          >
            Find it on Amazon
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .affiliates-header {
    margin-bottom: var(--vp-space-6);
  }

  .affiliates-section {
    margin-top: var(--vp-space-8, 4rem);
  }

  .affiliates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--vp-space-5);
  }

  .affiliate-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--vp-space-3);
  }

  .affiliate-name {
    font-family: 'Cinzel', serif;
    font-size: 1.3rem;
    color: var(--vp-text-primary);
    margin: 0;
  }

  .affiliate-desc {
    color: var(--vp-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
