---
/**
 * Press home — two trailers explain the book, then buy or free chapter.
 */
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import BriefCTA from '../components/BriefCTA.astro';
import { products, formatPrice, PRESALE_ENDS_LABEL } from '../commerce.js';

const formats = [
  products.softcover,
  products.hardcover,
  products.companion,
  products.hardcoverCompanionBundle,
  products.foundersEdition,
  products.limitedFounders,
];

const ARTICLES_DIR = path.join(process.cwd(), 'content', 'articles');
type ArticleCard = {
  slug: string;
  title: string;
  dek: string;
  date: string;
  image?: string;
  tags: string[];
};

function loadPublished(): ArticleCard[] {
  if (!fs.existsSync(ARTICLES_DIR)) return [];
  const out: ArticleCard[] = [];
  for (const file of fs.readdirSync(ARTICLES_DIR)) {
    if (!file.endsWith('.md')) continue;
    const raw = fs.readFileSync(path.join(ARTICLES_DIR, file), 'utf-8');
    const fm = matter(raw);
    if (!fm.data || fm.data.status === 'draft' || !fm.data.slug) continue;
    out.push({
      slug: fm.data.slug,
      title: fm.data.title || fm.data.slug,
      dek: fm.data.dek || fm.data.description || '',
      date: String(fm.data.date || ''),
      image: fm.data.image,
      tags: Array.isArray(fm.data.tags) ? fm.data.tags : [],
    });
  }
  return out.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
}

const published = loadPublished();
const lead = published[0] ?? null;
const secondary = published.slice(1, 3);
---

<BaseLayout
  title="The Veil Press"
  description="Independent press documenting durable power — architecture, money, narrative, access. Books as the deep layer. The desk as the continuous signal."
  image={lead?.image || '/cover.jpg'}
>
  <div class="home">
    <!-- ── HERO: Book + trailer front and centre ── -->
    <section class="home-hero">
      <div class="home-hero-stage" aria-hidden="true"></div>
      <div class="home-hero-panel">
        <p class="vp-eyebrow">Volume I · Pre-order Now</p>
        <h1 class="home-hero-title">The Veil of the Square Mile</h1>
        <p class="home-hero-dek">
          The invisible British financial empire — documented, not dramatized.
        </p>
        <p class="home-hero-author">Jack Schumacher</p>

        <div class="hero-trailer-frame">
          <video
            class="hero-trailer-video"
            controls
            playsinline
            preload="metadata"
            poster="/cover.jpg"
            aria-label="The Veil of the Square Mile — official trailer"
          >
            <source src="/videos/square-mile-trailer.mp4" type="video/mp4" />
          </video>
        </div>
        <p class="home-trailer-caption">The book</p>

        <div class="home-hero-actions">
          <a href="#buy" class="vp-btn vp-btn--primary vp-btn--gold">Pre-order</a>
          <a href="#companion" class="vp-btn vp-btn--primary">Companion trailer</a>
          <a href="/brief?src=home-hero" class="vp-btn vp-btn--secondary">Get the first chapter free</a>
        </div>
      </div>
    </section>

    <!-- ── COMPANION TRAILER ── -->
    <section class="home-section home-companion" id="companion">
      <div class="home-section-inner">
        <div class="vp-glass vp-glass--card companion-card">
          <div class="companion-copy">
            <p class="vp-eyebrow">Companion Guide · On presale</p>
            <h2 class="depth-title">The Companion Guide</h2>
            <p class="depth-dek">
              Sources, timelines, dynastic trees, glossary, bibliography, and the
              steelman of objections. The book is the argument; this is the map.
            </p>
            <div class="depth-actions">
              <a href={products.companion.url} class="vp-btn vp-btn--primary" target="_blank" rel="noopener noreferrer">
                {products.companion.label}
              </a>
            </div>
          </div>
          <div class="companion-trailer-frame">
            <video
              class="companion-trailer-video"
              controls
              playsinline
              preload="metadata"
              poster="/companion-cover.jpg"
              aria-label="Companion Guide — trailer"
            >
              <source src="/videos/companion_trailer.mp4" type="video/mp4" />
            </video>
            <p class="home-trailer-caption">The Companion Guide</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── PRE-ORDER CARDS ── -->
    <section class="home-section home-buy" id="buy">
      <div class="home-section-inner">
        <h2 class="vp-section-label">Pre-order</h2>
        <p class="vp-text-secondary" style="margin-bottom:var(--vp-space-5);max-width:36rem;">
          Print and Founders editions on presale through {PRESALE_ENDS_LABEL}.
          Each card opens checkout. Digital formats: Coming August 26th.
        </p>
        <div class="buy-grid">
          {formats.map((p) => (
            <a
              href={p.url}
              class:list={[
                'vp-glass',
                'vp-glass--card',
                'buy-card',
                p === products.foundersEdition && 'buy-card-featured',
                p === products.limitedFounders && 'buy-card-featured buy-card-limited',
              ]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="buy-card-inner">
                <p class="vp-eyebrow">{p === products.limitedFounders ? 'Complete set' : 'Presale'}</p>
                <h3 class="buy-card-title">{p.name}</h3>
                <p class="buy-card-price">{formatPrice(p.price)}</p>
                <p class="buy-card-desc">{p.shippingNote || p.blurb}</p>
                <span class="buy-card-cta">Pre-order →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── DESK (secondary) ── -->
    <section class="home-section home-lead">
      <div class="home-section-inner">
        <h2 class="vp-section-label">From the Desk</h2>
        <p class="vp-text-secondary" style="margin-bottom:var(--vp-space-4);">
          Continuous signal. Articles and analysis on durable power — sourced, on the record.
        </p>
        {lead ? (
          <a href={`/desk/${lead.slug}`} class="lead-card vp-glass vp-glass--card">
            {lead.image && (
              <div class="lead-card-media">
                <img src={lead.image} alt="" loading="lazy" />
              </div>
            )}
            <div class="lead-card-body">
              <p class="vp-eyebrow">Lead</p>
              <h3 class="lead-card-title">{lead.title}</h3>
              {lead.dek && <p class="lead-card-dek">{lead.dek}</p>}
              <div class="lead-card-meta">
                {lead.date && (
                  <time datetime={lead.date}>
                    {new Date(lead.date).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                )}
                <span class="lead-card-more">Continue reading →</span>
              </div>
            </div>
          </a>
        ) : (
          <div class="vp-glass vp-glass--card empty-panel">
            <p class="vp-text-secondary">The desk opens when the next package lands.</p>
            <a href="/desk" class="vp-btn vp-btn--ghost">Desk index</a>
          </div>
        )}

        {secondary.length > 0 && (
          <ul class="secondary-list">
            {secondary.map((a) => (
              <li>
                <a href={`/desk/${a.slug}`} class="secondary-row">
                  <span class="secondary-title">{a.title}</span>
                  {a.date && (
                    <time datetime={a.date}>
                      {new Date(a.date).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}

        <p class="section-foot">
          <a href="/desk" class="vp-btn vp-btn--ghost">All desk pieces →</a>
        </p>

        <AdSlot slot="home-mid" />
      </div>
    </section>

    <!-- ── BRIEF ── -->
    <section class="home-section home-brief">
      <div class="home-section-inner">
        <BriefCTA source="home-bottom" />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-bottom: var(--vp-space-8);
  }

  /* ── Hero ── */
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--vp-space-8) var(--vp-space-5) var(--vp-space-10);
  }

  .home-hero-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 40%, rgba(16, 19, 28, 0.2), transparent 70%),
      url('/limited-founders-hero-wide.jpg') center / cover no-repeat;
    opacity: 0.35;
    pointer-events: none;
  }

  .home-hero-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(7, 8, 12, 0.55) 0%,
      rgba(7, 8, 12, 0.75) 55%,
      var(--vp-bg-deep) 100%
    );
  }

  .home-hero-panel {
    position: relative;
    z-index: 2;
    max-width: 48rem;
    width: 100%;
    padding: var(--vp-space-6) var(--vp-space-5);
    text-align: center;
  }

  .home-hero-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 600;
    color: var(--vp-text-primary);
    margin: 0 0 var(--vp-space-4);
    letter-spacing: 0.04em;
    line-height: 1.15;
  }

  .home-hero-dek {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--vp-text-secondary);
    margin: 0 auto var(--vp-space-3);
    max-width: 34rem;
  }

  .home-hero-author {
    font-size: 0.95rem;
    color: var(--vp-text-muted);
    margin: 0 0 var(--vp-space-5);
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vp-space-3);
    justify-content: center;
  }

  .home-hero-secondary {
    margin: var(--vp-space-4) 0 var(--vp-space-5);
    font-size: 0.9rem;
    color: var(--vp-text-muted);
  }

  .home-hero-secondary a {
    color: var(--vp-accent-gold);
    text-decoration: none;
    font-weight: 500;
  }

  .home-hero-secondary a:hover {
    color: var(--vp-accent-gold-hi);
    text-decoration: underline;
  }

  .vp-btn--gold {
    background: var(--vp-accent-gold);
    color: #0c0e14;
    border-color: var(--vp-accent-gold);
  }

  .vp-btn--gold:hover {
    background: var(--vp-accent-gold-hi);
  }

  /* Hero trailer frame — kept, below primary CTA */
  .hero-trailer-frame {
    border-radius: var(--vp-radius-md, 6px);
    overflow: hidden;
    border: 1px solid var(--vp-edge);
    background: #000;
    margin: 0 auto;
    max-width: 100%;
    box-shadow: 0 0 40px rgba(196, 165, 116, 0.08), 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .hero-trailer-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .home-trailer-caption {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--vp-text-muted);
    text-align: center;
  }

  /* ── Sections ── */
  .home-section {
    padding: var(--vp-space-6) var(--vp-space-5);
  }

  .home-section-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .vp-section-label {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--vp-accent-gold);
    margin: 0 0 var(--vp-space-2);
    text-transform: uppercase;
  }

  /* ── Companion ── */
  .companion-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--vp-space-6);
    align-items: center;
    padding: var(--vp-space-6);
  }

  .companion-copy {
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-3);
  }

  .companion-trailer-frame {
    border-radius: var(--vp-radius-sm);
    overflow: hidden;
    border: 1px solid var(--vp-edge);
    background: #000;
    box-shadow: 0 0 24px rgba(196, 165, 116, 0.06), 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .companion-trailer-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* ── Buy cards ── */
  .buy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--vp-space-4);
  }

  .buy-card {
    text-decoration: none;
    color: inherit;
    padding: 0;
    overflow: hidden;
    transition: border-color var(--vp-duration) var(--vp-ease);
  }

  .buy-card:hover {
    border-color: var(--vp-edge-hot);
  }

  .buy-card:hover .buy-card-cta,
  .buy-card:hover .buy-card-title {
    color: var(--vp-accent-gold);
  }

  .buy-card-inner {
    padding: var(--vp-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-1);
    height: 100%;
  }

  .buy-card-title {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem;
    color: var(--vp-text-primary);
    margin: 0;
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  .buy-card-price {
    font-family: 'Cinzel', serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--vp-accent-gold);
    margin: 0;
  }

  .buy-card-desc {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--vp-text-secondary);
    margin: 0;
    flex: 1;
  }

  .buy-card-cta {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--vp-accent-gold);
    margin-top: var(--vp-space-2);
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  .buy-card-featured {
    border-color: rgba(196, 165, 116, 0.25);
  }

  .buy-card-limited {
    border-color: rgba(196, 165, 116, 0.35);
    box-shadow: 0 0 20px rgba(196, 165, 116, 0.06);
  }

  /* ── Desk ── */
  .lead-card,
  .secondary-row,
  .vp-btn {
    cursor: pointer;
  }

  .lead-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr);
    gap: 0;
    text-decoration: none;
    overflow: hidden;
    padding: 0;
  }

  .lead-card-media {
    min-height: 220px;
    background: var(--vp-bg-fog);
  }

  .lead-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lead-card-body {
    padding: var(--vp-space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lead-card-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    color: var(--vp-text-primary);
    margin: 0 0 var(--vp-space-3);
    line-height: 1.3;
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  .lead-card:hover .lead-card-title {
    color: var(--vp-accent-gold);
  }

  .lead-card-dek {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--vp-text-secondary);
    margin: 0 0 var(--vp-space-4);
  }

  .lead-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--vp-space-4);
    font-size: 0.85rem;
    color: var(--vp-text-muted);
  }

  .lead-card-more {
    color: var(--vp-accent-gold);
    font-weight: 500;
  }

  .secondary-list {
    list-style: none;
    margin: var(--vp-space-5) 0 0;
    padding: 0;
    border-top: 1px solid var(--vp-rule);
  }

  .secondary-row {
    display: flex;
    justify-content: space-between;
    gap: var(--vp-space-4);
    padding: var(--vp-space-4) 0;
    border-bottom: 1px solid var(--vp-rule);
    text-decoration: none;
    color: inherit;
  }

  .secondary-row:hover .secondary-title {
    color: var(--vp-accent-gold);
  }

  .secondary-title {
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    color: var(--vp-text-primary);
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  .secondary-row time {
    flex-shrink: 0;
    font-size: 0.8rem;
    color: var(--vp-text-muted);
  }

  .section-foot {
    margin: var(--vp-space-4) 0 0;
  }

  /* ── Brief ── */
  .depth-title {
    font-family: 'Cinzel', serif;
    font-size: 1.35rem;
    color: var(--vp-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .depth-dek {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--vp-text-secondary);
    margin: 0;
  }

  .depth-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vp-space-3);
    margin-top: var(--vp-space-2);
  }

  .empty-panel {
    padding: var(--vp-space-6);
    text-align: center;
  }

  /* ── Enter animations ── */
  .home-hero-panel,
  .home-companion,
  .home-buy,
  .home-lead,
  .home-brief {
    animation: home-rise 0.85s var(--vp-ease) both;
  }
  .home-companion { animation-delay: 0.06s; }
  .home-buy       { animation-delay: 0.12s; }
  .home-lead      { animation-delay: 0.18s; }
  .home-brief     { animation-delay: 0.24s; }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-panel,
    .home-companion,
    .home-buy,
    .home-lead,
    .home-brief {
      animation: none;
    }
  }

  /* ── Responsive ── */
  @media (max-width: 800px) {
    .lead-card {
      grid-template-columns: 1fr;
    }
    .lead-card-media {
      min-height: 180px;
    }

    .companion-card {
      grid-template-columns: 1fr;
    }

    .hero-trailer-frame {
      max-width: 100%;
    }
  }

  @media (max-width: 600px) {
    .buy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
