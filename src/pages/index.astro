---
/**
 * Press home — the main film, then a clear path: buy the book,
 * read the first chapter free, watch, or read the desk.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BriefCTA from '../components/BriefCTA.astro';
import { products, formatPrice, LIVE_BANNER } from '../commerce.js';
---

<BaseLayout
  title="The Veil Press"
  description="Independent press documenting durable power — architecture, money, narrative, access. Books as the deep layer. The desk as the continuous signal."
  image="/cover.jpg"
>
  <div class="home">
    <!-- ── HERO: the main film, then the path ── -->
    <section class="home-hero">
      <div class="home-hero-stage" aria-hidden="true"></div>
      <div class="home-hero-panel">
        <p class="vp-eyebrow">Volume I · Available now</p>
        <h1 class="home-hero-title">The Veil of the Square Mile</h1>
        <p class="home-hero-dek">
          The invisible British financial empire — documented, not dramatized.
        </p>
        <p class="home-hero-author">Jack Schumacher</p>

        <div class="hero-trailer-frame">
          <video
            class="hero-trailer-video"
            controls
            playsinline
            preload="metadata"
            poster="/cover.jpg"
            aria-label="The Veil of the Square Mile — official trailer"
          >
            <source src="/videos/square-mile-trailer.mp4" type="video/mp4" />
          </video>
        </div>
        <p class="home-trailer-caption">The book</p>
      </div>
    </section>

    <!-- ── THE PATH: buy · free chapter · watch · read ── -->
    <section class="home-section home-path" id="buy">
      <div class="home-section-inner">
        <h2 class="vp-section-label">Start here</h2>
        <div class="path-grid">
          <a href="#get" class="vp-glass vp-glass--card path-card path-card--primary">
            <h3 class="path-title">Get the book</h3>
            <p class="path-dek">Softcover, hardcover, or the Companion. Ships now.</p>
            <span class="path-arrow">Buy →</span>
          </a>
          <a href="/brief?src=home" class="vp-glass vp-glass--card path-card">
            <h3 class="path-title">Read the first chapter free</h3>
            <p class="path-dek">Volume Zero and Part I — no card, no catch.</p>
            <span class="path-arrow">Free chapter →</span>
          </a>
          <a href="/watch" class="vp-glass vp-glass--card path-card">
            <h3 class="path-title">Watch</h3>
            <p class="path-dek">The Record — films and the archive.</p>
            <span class="path-arrow">Watch →</span>
          </a>
          <a href="/desk" class="vp-glass vp-glass--card path-card">
            <h3 class="path-title">Read the Desk</h3>
            <p class="path-dek">News and analysis on durable power.</p>
            <span class="path-arrow">Desk →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ── COMPACT BUY LANDING ── -->
    <section class="home-section home-get" id="get">
      <div class="home-section-inner">
        <p class="vp-text-secondary home-get-dek" style="max-width:40rem;">
          {LIVE_BANNER}
        </p>
        <div class="buy-grid">
          {[
            products.softcover,
            products.hardcover,
            products.hardcoverCompanionBundle,
          ].map((p) => (
            <a
              href={p.url}
              class:list={[
                'vp-glass',
                'vp-glass--card',
                'buy-card',
                p === products.softcover && 'buy-card-suggested',
                p === products.hardcoverCompanionBundle && 'buy-card-featured',
              ]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="buy-card-inner">
                <p class="vp-eyebrow">
                  {p === products.hardcoverCompanionBundle
                    ? 'The set'
                    : p === products.softcover
                      ? 'Start here'
                      : 'Available now'}
                </p>
                <h3 class="buy-card-title">{p.name}</h3>
                <p class="buy-card-price">{formatPrice(p.price)}</p>
                <p class="buy-card-desc">{p.blurb}</p>
                {p.shippingNote ? <p class="buy-card-ship">{p.shippingNote}</p> : null}
                <p class="buy-card-ship">{p.deliveryNote}</p>
                <span class="buy-card-cta">Buy →</span>
              </div>
            </a>
          ))}
        </div>
        <p class="home-get-note vp-text-muted">
          More formats, the digital edition, and the full library —{' '}
          <a href="/library">browse the Library</a>. Not ready to spend yet?{' '}
          <a href="/brief?src=home-buy">Read the first chapter free</a>.
        </p>

        <div class="home-get-capture">
          <BriefCTA source="home-bottom" />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-bottom: var(--vp-space-8);
  }

  /* ── Hero ── */
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--vp-space-8) var(--vp-space-5) var(--vp-space-8);
  }

  .home-hero-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 40%, rgba(16, 19, 28, 0.2), transparent 70%),
      url('/limited-founders-hero-wide.jpg') center / cover no-repeat;
    opacity: 0.35;
    pointer-events: none;
  }

  .home-hero-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(7, 8, 12, 0.55) 0%,
      rgba(7, 8, 12, 0.75) 55%,
      var(--vp-bg-deep) 100%
    );
  }

  .home-hero-panel {
    position: relative;
    z-index: 2;
    max-width: 52rem;
    width: 100%;
    padding: var(--vp-space-6) var(--vp-space-5);
    text-align: center;
  }

  .home-hero-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 600;
    color: var(--vp-text-primary);
    margin: 0 0 var(--vp-space-3);
    letter-spacing: 0.04em;
    line-height: 1.15;
  }

  .home-hero-dek {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--vp-text-secondary);
    margin: 0 auto var(--vp-space-3);
    max-width: 34rem;
  }

  .home-hero-author {
    font-size: 0.95rem;
    color: var(--vp-text-muted);
    margin: 0 0 var(--vp-space-6);
  }

  /* Hero trailer frame — the film is the front doors */
  .hero-trailer-frame {
    border-radius: var(--vp-radius-md, 6px);
    overflow: hidden;
    border: 1px solid var(--vp-edge);
    background: #000;
    margin: 0 auto;
    max-width: 100%;
    box-shadow: 0 0 40px rgba(196, 165, 116, 0.08), 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .hero-trailer-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .home-trailer-caption {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--vp-text-muted);
    text-align: center;
  }

  /* ── Sections ── */
  .home-section {
    padding: var(--vp-space-7) var(--vp-space-5);
  }

  .home-section-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .vp-section-label {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--vp-accent-gold);
    margin: 0 0 var(--vp-space-3);
    text-transform: uppercase;
  }

  /* ── Path tiles ── */
  .path-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--vp-space-4);
  }

  .path-card {
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-2);
    text-decoration: none;
    color: inherit;
    padding: var(--vp-space-5);
    transition: border-color var(--vp-duration) var(--vp-ease);
  }

  .path-card:hover {
    border-color: var(--vp-edge-hot);
  }

  .path-card--primary {
    border-color: rgba(196, 165, 116, 0.4);
  }

  .path-title {
    font-family: 'Cinzel', serif;
    font-size: 1.15rem;
    color: var(--vp-text-primary);
    margin: 0;
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  .path-card:hover .path-title,
  .path-card:hover .path-arrow {
    color: var(--vp-accent-gold);
  }

  .path-dek {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--vp-text-secondary);
    margin: 0;
    flex: 1;
  }

  .path-arrow {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--vp-accent-gold);
    margin-top: var(--vp-space-2);
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  /* ── Buy ── */
  .buy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--vp-space-4);
    margin-top: var(--vp-space-4);
  }

  .home-get-dek {
    margin-bottom: var(--vp-space-2);
  }

  .buy-card {
    text-decoration: none;
    color: inherit;
    padding: 0;
    overflow: hidden;
    transition: border-color var(--vp-duration) var(--vp-ease);
  }

  .buy-card:hover {
    border-color: var(--vp-edge-hot);
  }

  .buy-card:hover .buy-card-cta,
  .buy-card:hover .buy-card-title {
    color: var(--vp-accent-gold);
  }

  .buy-card-inner {
    padding: var(--vp-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-1);
    height: 100%;
  }

  .buy-card-title {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem;
    color: var(--vp-text-primary);
    margin: 0;
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  .buy-card-price {
    font-family: 'Cinzel', serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--vp-accent-gold);
    margin: 0;
  }

  .buy-card-desc {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--vp-text-secondary);
    margin: 0;
    flex: 1;
  }

  .buy-card-ship {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--vp-text-muted);
    margin: 0;
  }

  .buy-card-cta {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--vp-accent-gold);
    margin-top: var(--vp-space-2);
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  .buy-card-suggested {
    border-color: rgba(196, 165, 116, 0.4);
  }

  .buy-card-featured {
    border-color: rgba(196, 165, 116, 0.25);
  }

  .home-get-note {
    font-size: 0.88rem;
    line-height: 1.6;
    margin: var(--vp-space-5) 0 0;
  }

  .home-get-note a {
    color: var(--vp-accent-gold);
    text-decoration: underline;
  }

  .home-get-capture {
    margin-top: var(--vp-space-6);
  }

  /* ── Enter animations ── */
  .home-hero-panel,
  .home-path,
  .home-get {
    animation: home-rise 0.85s var(--vp-ease) both;
  }
  .home-path { animation-delay: 0.08s; }
  .home-get  { animation-delay: 0.14s; }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-panel,
    .home-path,
    .home-get {
      animation: none;
    }
  }

  @media (max-width: 800px) {
    .hero-trailer-frame {
      max-width: 100%;
    }
  }

  @media (max-width: 600px) {
    .buy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
