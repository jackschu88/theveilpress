---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="watch-stub">
    <div class="vp-glass vp-glass--card">
      <h1>Watch</h1>
      <p class="vp-text-secondary">Cinema and visual storytelling</p>
      <p class="vp-text-muted">Video walkthroughs and the reader app are in development.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .watch-stub { max-width: 72rem; margin: 0 auto; padding: var(--vp-space-7) var(--vp-space-5); }
  .vp-glass--card { padding: var(--vp-space-6); text-align: center; }
</style>
