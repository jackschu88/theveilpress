---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BriefCTA from '../../components/BriefCTA.astro';
import ArchiveStrip from '../../components/ArchiveStrip.astro';
---
<BaseLayout
  title="Watch"
  description="The Veil Press record — the book trailer and the Companion Guide trailer, plus episodes from the archive. Canonical files stay on this site."
  image="/cover.jpg"
>
  <div class="vp-page watch-page">
    <header class="watch-header">
      <h1 class="vp-page-title">Watch</h1>
      <p class="vp-page-dek">
        The Record — films and episodes assembled into one archive. Two films
        open: the book, then the Companion Guide that maps it.
      </p>
    </header>

    <ArchiveStrip />

    <div class="watch-capture">
      <BriefCTA source="watch" />
    </div>

    <p class="watch-foot vp-text-muted">
      Also on{' '}
      <a href="https://x.com/deepdivefile" target="_blank" rel="noopener noreferrer">X</a>
      ,{' '}
      <a href="https://www.youtube.com/channel/UC1inbgx19VivnXyWGDWbaiw" target="_blank" rel="noopener noreferrer">YouTube</a>
      ,{' '}
      <a href="https://www.tiktok.com/@theveilpress" target="_blank" rel="noopener noreferrer">TikTok</a>
      , and{' '}
      <a href="https://www.facebook.com/profile.php?id=61592600831684" target="_blank" rel="noopener noreferrer">Facebook</a>
      . Canonical files stay on this site.
    </p>
  </div>
</BaseLayout>

<style>
  .watch-header {
    margin-bottom: var(--vp-space-7);
  }

  .watch-capture {
    margin-top: var(--vp-space-7);
  }

  .watch-foot {
    margin: var(--vp-space-6) 0 0;
    font-size: 0.85rem;
  }

  .watch-foot a {
    color: var(--vp-accent-gold, var(--gold));
    text-decoration: none;
  }

  .watch-foot a:hover {
    text-decoration: underline;
  }
</style>
