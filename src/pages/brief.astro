---
import BaseLayout from '../layouts/BaseLayout.astro';

const formAction = import.meta.env.PUBLIC_BRIEF_FORM_ACTION;
const hasFormAction = typeof formAction === 'string' && formAction.trim().length > 0;
const source = 'brief-direct';
---

<BaseLayout
  title="Get the First Chapter Free"
  description="Volume Zero and Part I of The Veil of the Square Mile, free. No card, no catch."
>
  <section class="brief-page">
    <div class="vp-glass vp-glass--card brief-card">
      <p class="vp-eyebrow">Free excerpt</p>
      <h1 class="brief-heading">Get the first chapter free</h1>

      <p class="brief-what">
        <em>The Veil of the Square Mile</em> is a documented history of the City of London
        Corporation — a medieval body that still sits at the center of global finance and operates
        with powers the rest of the United Kingdom does not share. Architecture on the record.
      </p>
      <p class="brief-desc">
        Enter your email for Volume Zero and Part I in full — the Introduction and “The Hidden
        Throne.” Instant access. No card.
      </p>

      {
        hasFormAction ? (
          <form class="brief-form" method="post" action="/api/brief-signup">
            <input
              class="brief-input"
              type="email"
              name="email"
              placeholder="Your email address"
              required
              autocomplete="email"
            />
            <input type="hidden" name="source" id="brief-source" value={source} />
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
            <button class="brief-submit" type="submit">Send me the chapter</button>
          </form>
        ) : (
          <div class="brief-form brief-form--disabled">
            <input class="brief-input" type="email" placeholder="Your email address" disabled />
            <button class="brief-submit" type="button" disabled>Send me the chapter</button>
          </div>
        )
      }
      <p class="vp-text-muted brief-disclaimer">
        {hasFormAction
          ? 'No spam, no resale, unsubscribe anytime.'
          : 'Subscriptions not configured yet. Check back soon.'}
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var src = params.get('src');
    var field = document.getElementById('brief-source');
    if (src && field) field.value = src;
  })();
</script>

<style>
  .brief-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--vp-space-7) var(--vp-space-5);
  }

  .brief-card {
    max-width: 32rem;
    width: 100%;
    padding: var(--vp-space-6);
    text-align: center;
  }

  .brief-heading {
    font-family: 'Cinzel', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--vp-text-primary);
    margin: 0 0 var(--vp-space-4);
  }

  .brief-what {
    color: var(--vp-text-secondary);
    margin: 0 auto var(--vp-space-3);
    max-width: 28rem;
    line-height: 1.6;
    font-size: 0.98rem;
    text-align: left;
  }

  .brief-desc {
    color: var(--vp-text-muted);
    margin: 0 auto var(--vp-space-5);
    max-width: 26rem;
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .brief-form {
    display: flex;
    gap: var(--vp-space-2);
    max-width: 24rem;
    margin: 0 auto var(--vp-space-4);
  }

  .brief-input {
    flex: 1;
    padding: var(--vp-space-3) var(--vp-space-4);
    border: 1px solid var(--vp-edge);
    border-radius: var(--vp-radius-sm);
    background: var(--vp-bg-deep);
    color: var(--vp-text-primary);
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
  }

  .brief-input:focus {
    outline: none;
    border-color: var(--vp-edge-hot);
  }

  .brief-submit {
    padding: var(--vp-space-3) var(--vp-space-5);
    border: none;
    border-radius: var(--vp-radius-sm);
    background: var(--vp-accent-gold);
    color: #0c0e14;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--vp-duration) var(--vp-ease);
  }

  .brief-submit:hover {
    background: var(--vp-accent-gold-hi);
  }

  .brief-disclaimer {
    font-size: 0.85rem;
    margin: 0;
  }

  .brief-form--disabled .brief-input {
    opacity: 0.5;
  }

  .brief-form--disabled .brief-submit {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 520px) {
    .brief-form {
      flex-direction: column;
    }
  }
</style>
