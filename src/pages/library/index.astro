---
/**
 * Library catalogue — Astro (no AppRoot island).
 * React cinematic pages remain on /library/veil, /library/map, etc.
 */
import LibraryLayout from '../../layouts/LibraryLayout.astro';

const titles = [
  {
    href: '/library/veil',
    volume: 'Volume I',
    title: 'The Veil of the Square Mile',
    dek: 'The invisible British financial empire — architecture of money and access, on the record. Softcover & hardcover on presale through August 26, 2026. Digital: Coming August 26th.',
    cta: 'Pre-order print formats',
    image: '/cover.jpg',
    badge: 'Presale',
  },
  {
    href: '/library/map',
    volume: 'Companion',
    title: 'The Map',
    dek: 'Field guide to the structures the desk keeps naming. Standalone Companion Guide: Coming August 26th. Included (signed) in Limited Founders.',
    cta: 'Watch the Map',
    image: '/companion-cover.jpg',
    badge: 'Coming August 26th',
  },
  {
    href: '/library/founders',
    volume: 'Founders',
    title: 'Founders & limited sets',
    dek: 'Signed and scarce editions — Limited Founders and Founders Edition. On presale through August 26, 2026.',
    cta: 'Pre-order Founders',
    image: '/limited-founders-hero.jpg',
    badge: 'Presale',
  },
];
---

<LibraryLayout
  title="Library"
  description="Books and guides from The Veil Press — Volume I, Companion Guide, and Founders editions."
  image="/cover.jpg"
>
  <div class="lib">
    <header class="lib-header">
      <p class="vp-eyebrow">Catalogue</p>
      <h1 class="vp-page-title">Library</h1>
      <p class="vp-page-dek">
        Books and companions from The Veil Press. Softcover, hardcover, and both
        Founders editions are in
        <strong style="color:var(--vp-accent-gold)"> presale through August 26, 2026</strong>.
        Digital formats and the Companion Guide:
        <strong style="color:var(--vp-accent-gold)"> Coming August 26th</strong>.
        Each title stands alone; the series shares one standard:
        institutions on the record, not cabals in the shadows.
      </p>
    </header>

    <ul class="lib-grid">
      {titles.map((t) => (
        <li>
          <a href={t.href} class="lib-card vp-glass vp-glass--card">
            <div class="lib-card-media">
              <img src={t.image} alt="" loading="lazy" />
            </div>
            <div class="lib-card-body">
              <div class="lib-card-meta">
                <span class="vp-eyebrow lib-volume">{t.volume}</span>
                <span class="lib-badge">{t.badge}</span>
              </div>
              <h2 class="lib-card-title">{t.title}</h2>
              <p class="lib-card-dek">{t.dek}</p>
              <span class="lib-card-cta">{t.cta} →</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</LibraryLayout>

<style>
  .lib {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--vp-space-6) 0 var(--vp-space-8);
  }

  .lib-header {
    margin-bottom: var(--vp-space-7);
  }

  .lib-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-5);
  }

  .lib-card {
    display: grid;
    grid-template-columns: minmax(0, 160px) minmax(0, 1fr);
    gap: 0;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    padding: 0;
    transition: border-color var(--vp-duration) var(--vp-ease);
  }

  .lib-card:hover {
    border-color: var(--vp-edge-hot);
  }

  .lib-card:hover .lib-card-title,
  .lib-card:hover .lib-card-cta {
    color: var(--vp-accent-gold);
  }

  .lib-card-media {
    background: var(--vp-bg-fog);
    min-height: 180px;
  }

  .lib-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lib-card-body {
    padding: var(--vp-space-5) var(--vp-space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--vp-space-2);
  }

  .lib-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--vp-space-3);
    margin-bottom: var(--vp-space-1);
  }

  .lib-volume {
    margin: 0;
  }

  .lib-badge {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vp-accent-steel);
    border: 1px solid var(--vp-edge);
    border-radius: var(--vp-radius-sm);
    padding: 0.15rem 0.45rem;
  }

  .lib-card-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--vp-text-primary);
    margin: 0;
    line-height: 1.3;
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  .lib-card-dek {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--vp-text-secondary);
    margin: 0;
    max-width: 36rem;
  }

  .lib-card-cta {
    margin-top: var(--vp-space-2);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--vp-accent-gold);
    transition: color var(--vp-duration-fast) var(--vp-ease);
  }

  @media (max-width: 640px) {
    .lib-card {
      grid-template-columns: 1fr;
    }
    .lib-card-media {
      min-height: 160px;
    }
  }
</style>
