---
import LibraryLayout from '../../layouts/LibraryLayout.astro';
import ExecutiveFounderPage from '../../islands/ExecutiveFounderPage';
---

<LibraryLayout
  title="Signed hardcover"
  description="The Founders seed run is closed. Signed hardcovers of The Veil of the Square Mile are available while the current short run lasts."
  image="/limited-founders-hero-wide.jpg"
>
  <ExecutiveFounderPage client:only="react">
    <div slot="fallback" class="veil-fallback">
      <p class="vp-eyebrow">Seed run closed</p>
      <h1 class="vp-page-title">Signed hardcover</h1>
      <p class="vp-page-dek">Loading…</p>
    </div>
  </ExecutiveFounderPage>
</LibraryLayout>

<style>
  .veil-fallback { padding: var(--vp-space-6) 0; min-height: 40vh; }
</style>
