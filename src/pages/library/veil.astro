---
/**
 * Volume I — original cinematic SquareMile product page (exact content/layout),
 * hydrated under Astro Nav + LibraryLayout. Paths remapped /books → /library.
 */
import LibraryLayout from '../../layouts/LibraryLayout.astro';
import SquareMilePage from '../../islands/SquareMilePage';
import { products } from '../../commerce.js';

const { softcover, hardcover } = products;
---

<LibraryLayout
  title="The Veil of the Square Mile"
  description="Volume I from The Veil Press. Softcover and hardcover ship now. Signed hardcover is a short run. Digital editions available immediately."
  image="/cover.jpg"
>
  <div class="veil-island">
    <SquareMilePage client:only="react">
      <div slot="fallback" class="veil-fallback">
        <p class="vp-eyebrow">Volume I · The Veil Press</p>
        <h1 class="vp-page-title">The Veil of the Square Mile</h1>
        <p class="vp-page-dek">
          The invisible British financial empire — documented, not dramatized.
          Softcover and hardcover ship now. Digital editions available immediately.
        </p>
        <div class="veil-fallback-actions">
          <a href={softcover.url} class="vp-btn vp-btn--primary">
            {softcover.label}
          </a>
          <a href={hardcover.url} class="vp-btn vp-btn--secondary">
            {hardcover.label}
          </a>
        </div>
      </div>
    </SquareMilePage>
  </div>
</LibraryLayout>

<script is:inline>
  if (typeof window.fbq === 'function') {
    window.fbq('track', 'ViewContent', { content_name: 'The Veil of the Square Mile' });
  }
</script>

<style>
  .veil-island {
    position: relative;
    z-index: 1;
    min-height: 80vh;
  }

  .veil-fallback {
    padding: var(--vp-space-7) var(--vp-space-5);
    min-height: 40vh;
    max-width: 72rem;
    margin: 0 auto;
  }

  .veil-fallback-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vp-space-3);
    margin-top: var(--vp-space-5);
  }
</style>
