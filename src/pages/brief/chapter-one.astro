---
/**
 * Free lead-magnet excerpt — Volume Zero + Part I.
 * End CTA pushes softcover as the clear next step.
 */
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';

const EXCERPT_DIR = path.join(process.cwd(), 'content', 'excerpt');
const intro = fs.readFileSync(path.join(EXCERPT_DIR, '00-intro.md'), 'utf-8');
const partOne = fs.readFileSync(path.join(EXCERPT_DIR, '01-part-one.md'), 'utf-8');

const introHtml = await marked.parse(intro);
const partOneHtml = await marked.parse(partOne);

const softcoverUrl = 'https://shop.theveilpress.com/l/jiytnb';
---

<BaseLayout
  title="The First Chapter, Free"
  description="Volume Zero and Part I of The Veil of the Square Mile — the free excerpt."
>
  <article class="excerpt-page">
    <header class="excerpt-header">
      <p class="vp-eyebrow">Free excerpt</p>
      <h1 class="vp-page-title">The Veil of the Square Mile</h1>
      <p class="vp-page-dek">Volume Zero: Introduction, and Part I: The Hidden Throne — in full.</p>
    </header>

    <div class="excerpt-content" set:html={introHtml} />
    <hr class="excerpt-divider" />
    <div class="excerpt-content" set:html={partOneHtml} />

    <div class="excerpt-foot">
      <div class="vp-glass vp-glass--card excerpt-buy-card">
        <p class="vp-eyebrow">Fourteen more parts</p>
        <h2 class="excerpt-buy-heading">Get the full book in print</h2>
        <p class="excerpt-buy-copy">
          Softcover, 384 pages. $39.99 + shipping. Presale through August 26.
          Same sources. The rest of the architecture.
        </p>
        <a
          href={softcoverUrl}
          class="vp-btn vp-btn--primary vp-btn--gold"
          rel="noopener noreferrer"
          target="_blank"
        >
          Pre-order softcover — $39.99 →
        </a>
      </div>
      <p class="excerpt-alt-link">
        <a href="/library/veil">See all editions</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .excerpt-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--vp-space-7) var(--vp-space-5);
  }

  .excerpt-header {
    text-align: center;
    margin-bottom: var(--vp-space-7);
  }

  .excerpt-content {
    color: var(--vp-text-primary);
    line-height: 1.75;
    font-size: 1.08rem;
    font-family: 'Source Sans 3', system-ui, sans-serif;
  }

  .excerpt-content :global(h1) {
    font-family: 'Cinzel', serif;
    font-size: 1.6rem;
    margin: 0 0 var(--vp-space-2);
    color: var(--vp-text-primary);
  }

  .excerpt-content :global(h2) {
    font-family: 'Cinzel', serif;
    font-size: 1.35rem;
    margin: var(--vp-space-7) 0 var(--vp-space-3);
    color: var(--vp-text-primary);
  }

  .excerpt-content :global(h3) {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem;
    margin: var(--vp-space-5) 0 var(--vp-space-2);
  }

  .excerpt-content :global(p) {
    margin: 0 0 var(--vp-space-4);
  }

  .excerpt-content :global(em) {
    color: var(--vp-text-secondary);
  }

  .excerpt-content :global(strong) {
    color: var(--vp-text-primary);
    font-weight: 600;
  }

  .excerpt-divider {
    border: none;
    border-top: 1px solid var(--vp-rule);
    margin: var(--vp-space-8) 0;
  }

  .excerpt-foot {
    margin-top: var(--vp-space-8);
    display: flex;
    flex-direction: column;
    gap: var(--vp-space-4);
    align-items: center;
    text-align: center;
  }

  .excerpt-buy-card {
    width: 100%;
    padding: var(--vp-space-6);
  }

  .excerpt-buy-heading {
    font-family: 'Cinzel', serif;
    font-size: 1.4rem;
    color: var(--vp-text-primary);
    margin: var(--vp-space-2) 0 var(--vp-space-3);
  }

  .excerpt-buy-copy {
    color: var(--vp-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--vp-space-5);
    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
  }

  .excerpt-alt-link {
    margin: 0;
    font-size: 0.9rem;
  }

  .excerpt-alt-link a {
    color: var(--vp-accent-gold);
    text-decoration: none;
  }

  .excerpt-alt-link a:hover {
    text-decoration: underline;
  }
</style>
