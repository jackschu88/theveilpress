---
import BaseLayout from './BaseLayout.astro';
---

<BaseLayout>
  <div class="desk-layout">
    <div class="desk-container">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .desk-layout {
    min-height: 100vh;
    background: var(--vp-bg-deep);
  }

  .desk-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--vp-space-6) var(--vp-space-5);
  }
</style>
