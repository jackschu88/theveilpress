---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} noindex={noindex}>
  <div class="desk-layout">
    <div class="desk-container">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .desk-layout {
    min-height: 100vh;
    background: var(--vp-bg-deep);
  }

  .desk-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--vp-space-6) var(--vp-space-5);
  }
</style>
